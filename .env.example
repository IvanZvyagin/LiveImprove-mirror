APP_DB_PASSWORD=apppass

# --- Сборка фронта в Docker (docker-compose.dev.yml) ---
# Dashboard Supabase → Settings → API: Project URL и anon public key.
# Для локального npm run dev те же ключи задаются в frontend/.env (см. frontend/.env.example).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Опционально:
# VITE_API_URL=http://localhost:8080/api/v1

# Supabase Auth — issuer для Spring OAuth2 Resource Server (JWT).
# В Dashboard: Settings → API; iss в access token = …/auth/v1
SUPABASE_ISSUER_URI=https://pevipmeoruuxqtdraqvr.supabase.co/auth/v1

# Origin фронта для CORS (профиль dev)
FRONTEND_ORIGIN=http://localhost:5173

# Опционально
# SUPABASE_JWK_SET_URI=https://pevipmeoruuxqtdraqvr.supabase.co/auth/v1/.well-known/jwks.json
