APP_DB_PASSWORD=apppass

# Supabase Auth — issuer для Spring OAuth2 Resource Server (JWT).
# В Dashboard: Settings → API; iss в access token = …/auth/v1
SUPABASE_ISSUER_URI=https://pevipmeoruuxqtdraqvr.supabase.co/auth/v1

# Origin фронта для CORS (профиль dev)
FRONTEND_ORIGIN=http://localhost:5173

# Опционально, по умолчанию совпадает с issuer + /.well-known/jwks.json
# SUPABASE_JWK_SET_URI=https://pevipmeoruuxqtdraqvr.supabase.co/auth/v1/.well-known/jwks.json
